---
import { Picture } from "astro:assets";
import before1 from "../assets/media/before-after/before-1.jpg";
import after1 from "../assets/media/before-after/after-1.jpg";
import before2 from "../assets/media/before-after/before-2.jpg";
import after2 from "../assets/media/before-after/after-2.jpg";
import before3 from "../assets/media/before-after/before-3.jpg";
import after3 from "../assets/media/before-after/after-3.jpg";
import before4 from "../assets/media/before-after/before-4.jpg";
import after4 from "../assets/media/before-after/after-4.jpg";
import { beforeAfterPairs } from "../data/works";

const media = {
  "fade-texture": { before: before1, after: after1 },
  "beard-shape": { before: before2, after: after2 },
  "classic-cut": { before: before3, after: after3 },
  camouflage: { before: before4, after: after4 },
} as const;
---

<section class="section" id="works" data-works>
  <div class="container">
    <p class="section__eyebrow" data-reveal>03 / Работы</p>
    <h2 class="section__title" data-reveal>До / после</h2>
    <p class="section__lead" data-reveal>
      Тяни ползунок или двигай стрелками. Shift — шаг покрупнее.
    </p>

    <div class="works-list">
      {
        beforeAfterPairs.map((pair) => {
          const imgs = media[pair.id as keyof typeof media];
          return (
            <figure class="compare" data-compare data-reveal>
              <Picture
                src={imgs.before}
                alt={`До: ${pair.title}`}
                class="compare__img"
                widths={[480, 720, 960]}
                sizes="(max-width: 899px) 100vw, 50vw"
                formats={["avif", "webp"]}
                quality={70}
                width={1600}
                height={1200}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
              <Picture
                src={imgs.after}
                alt={`После: ${pair.title}`}
                class="compare__img compare__after"
                widths={[480, 720, 960]}
                sizes="(max-width: 899px) 100vw, 50vw"
                formats={["avif", "webp"]}
                quality={70}
                width={1600}
                height={1200}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                data-compare-after="true"
              />
              <div class="compare__handle" aria-hidden="true"></div>
              <input
                class="compare__range"
                data-compare-range
                type="range"
                min="0"
                max="100"
                value="50"
                aria-label={`Сравнение до и после: ${pair.title}`}
              />
              <figcaption class="compare__caption">{pair.title}</figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>
</section>
